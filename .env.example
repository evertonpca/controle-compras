# O backend carrega .env.local e .env, preservando variáveis do processo.
# neon deploy preenche .env.local (ou .env, se existir).
# Também é possível testar PostgreSQL no PowerShell:
# $env:DATABASE_URL = 'postgresql://...'
# npm run dev
# Sem DATABASE_URL, desenvolvimento continua usando SQLite local.
# Copie a URL completa do Neon, incluindo sslmode e demais parâmetros.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Opcional: conexão direta para inicialização do schema.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
